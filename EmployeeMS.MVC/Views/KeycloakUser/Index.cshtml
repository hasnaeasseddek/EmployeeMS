@model IEnumerable<EmployeeMS.Shared.DTOs.Users.KeycloakUser>

<h2>Users List</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Username</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Roles</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Username</td>
                <td>@user.FirstName @user.LastName</td>
                <td>@user.Email</td>
                <td>
                    @foreach (var role in user.Roles)
                    {
                        <span class="badge bg-primary">@role.name</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

}

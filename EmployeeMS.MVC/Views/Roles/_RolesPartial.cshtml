@using EmployeeMS.Shared.DTOs.Role
@model List<RoleDto>

<h2 class="mb-3">Gestion des Rôles</h2>
<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nom du Rôle</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.id</td>
                <td>@role.name</td>
                <td>
                    <a href="#" class="btn btn-warning btn-sm">✏️ Modifier</a>
                    <a href="#" class="btn btn-danger btn-sm">🗑️ Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>

